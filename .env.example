# Prism environment variables. Copy to .env for local development and set the same keys in
# Vercel (Project > Settings > Environment Variables) for Preview and Production.
# Never commit real values. Variables starting with NEXT_PUBLIC_ are visible in the browser.

# --- Required -------------------------------------------------------------------------------

# Managed PostgreSQL connection string (Neon, Supabase or similar). Use the pooled URL for the app.
# Neon example:     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/prism?sslmode=require
# Supabase example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Direct (non-pooled) connection used only by Prisma migrations. Neon: the URL without "-pooler".
# Leave empty to use DATABASE_URL.
DIRECT_DATABASE_URL=

# Random secret of at least 32 characters for signing sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public origin of this deployment, no trailing slash. Used for auth callbacks and links in emails.
# Local: http://localhost:3000   Production: https://your-domain.example
APP_URL=http://localhost:3000

# Salt for hashing client IP addresses before they are stored (contact form, rate limits).
# Random, at least 16 characters.
IP_HASH_SALT=

# Same value as APP_URL. Used for canonical URLs, the sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (optional, required for password reset and contact notifications) ----------------

# Resend API key and a sender on a domain you have verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Prism <no-reply@your-domain.example>"
# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=

# --- Public contact details (optional) ------------------------------------------------------

NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
# WhatsApp number in international format, digits only, e.g. 447700900123. The button is hidden when empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Analytics (optional) --------------------------------------------------------------------

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loads only after the visitor consents.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Tests only ------------------------------------------------------------------------------

# A separate, disposable database for integration and end-to-end tests. Tests DELETE all data in it.
TEST_DATABASE_URL=

# Only for `prisma migrate dev` when your provider cannot create a shadow database.
SHADOW_DATABASE_URL=

# Optional: maximum database connections per server instance (default 5). Set 1 for local `prisma dev`.
DATABASE_POOL_MAX=

# Development seed login (npm run db:seed). Local only.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
